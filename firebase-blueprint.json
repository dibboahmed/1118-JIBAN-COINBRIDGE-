{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document for signed-in members",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Firebase Authentication UID of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Full name or username of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of user creation"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last sign-in"
        }
      },
      "required": ["id", "email"]
    },
    "PayoutOrder": {
      "title": "PayoutOrder",
      "description": "Crypto payout order record created by user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "tokenSymbol": { "type": "string" },
        "tokenNetwork": { "type": "string" },
        "cryptoAmount": { "type": "number" },
        "fiatCurrencyCode": { "type": "string" },
        "fiatCurrencySymbol": { "type": "string" },
        "fiatAmount": { "type": "number" },
        "country": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "accountNumber": { "type": "string" },
        "accountType": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "tokenSymbol", "cryptoAmount", "fiatCurrencyCode", "paymentMethod", "accountNumber"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles partitioned by Auth UID"
    },
    "/payout_orders/{orderId}": {
      "schema": "PayoutOrder",
      "description": "Payout orders created by user"
    }
  }
}
